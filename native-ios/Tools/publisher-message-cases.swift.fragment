    // Inject only into the existing simulator XCTest class before build-for-testing.
    // Uses Tarot's published CMP with Google's sample BANNER, never live inventory.
    // Exact English labels/body were observed in the publisher editor on 2026-10-29.
    // An older Opt out/Dismiss-only form must fail the explicit-undo check: Dismiss
    // is not opt-in. Propagation/network failures are failures, never fake choices.
    func testPublisherUSOptOutPersistsAndCanBeExplicitlyReversed() throws {
        expectedATTAction = "Ask App Not to Track"
        publisherLaunchUS(reset: true)
        let initial = try waitForSnapshot("strict publisher-message simulator guard") { _ in true }
        try require(initial.publisherMessageQA == true, "Publisher CMP audit guard is not active.")
        XCTAssertEqual(initial.initialTrackingAuthorizationRaw, 0)
        try publisherFinishOptionalATT()
        let baseline = try publisherWaitForUSState("published US message and sample banner", banner: true)
        try require(baseline.requiresPrivacyOptions == true, "UMP did not require the US privacy-options entry point.")
        recordEvidence("publisher-us-initial")

        let optOutSurface = try publisherOpenUSOptions(after: baseline)
        try publisherSelectUSOption(in: optOutSurface, allow: false)
        let optedOut = try publisherWaitForUSState("real US opt-out saved", expectedOptOut: 1)
        recordEvidence("publisher-us-opted-out")

        app.terminate()
        publisherLaunchUS(reset: false)
        try publisherFinishOptionalATT()
        let persisted = try publisherWaitForUSState("US opt-out persists across launch with sample banner",
                                                   expectedOptOut: 1, banner: true)
        XCTAssertEqual(persisted.gppSectionIDs, optedOut.gppSectionIDs)
        recordEvidence("publisher-us-opt-out-persisted")

        let allowSurface = try publisherOpenUSOptions(after: persisted)
        try publisherSelectUSOption(in: allowSurface, allow: true)
        _ = try publisherWaitForUSState("explicit Allow action undoes the US opt-out", expectedOptOut: 2)
        recordEvidence("publisher-us-explicit-allow")

        app.terminate()
        publisherLaunchUS(reset: false)
        try publisherFinishOptionalATT()
        _ = try publisherWaitForUSState("explicit US choice persists with sample banner",
                                       expectedOptOut: 2, banner: true)
        // GPP 2 means did-not-opt-out for these three fields, not ATT permission,
        // proof of personalized delivery, or a forecast of monetization.
        recordEvidence("publisher-us-explicit-allow-persisted")
    }

    private func publisherLaunchUS(reset: Bool) {
        app.launchArguments = ["--qa-english", "--qa-consent-us", "--qa-consent-observe",
                               "-AppleLanguages", "(en)", "-AppleLocale", "en_US"]
        if reset { app.launchArguments += ["--qa-consent-reset", "--qa-consent-fresh-case"] }
        app.launch()
    }

    private func publisherFinishOptionalATT() throws {
        try finishOptionalATTWithDenial()
    }

    private func publisherWaitForUSState(_ description: String, expectedOptOut: Int? = nil,
                                         banner: Bool = false) throws -> Snapshot {
        try waitForSnapshot(description) { state in
            guard state.publisherMessageQA == true, state.updateCompleted, !state.busy
            else { return false }
            if let expectedOptOut {
                // Google documents stored GPP after a decision. Its absence
                // before opening privacy options is not a baseline failure.
                guard state.gppPresent == true, state.gppSectionIDs == [7],
                      ["usNationalV1", "usNationalV2"].contains(state.gppObservation ?? ""),
                      state.gppSaleOptOut == expectedOptOut,
                      state.gppSharingOptOut == expectedOptOut,
                      state.gppTargetedAdvertisingOptOut == expectedOptOut else { return false }
            }
            return !banner || (state.automaticPresentationAllowed && state.canRequestAds && state.sdkStarted
                               && state.requestCount > 0 && state.loadedBannerCount > 0)
        }
    }

    private func publisherOpenUSOptions(after previous: Snapshot) throws -> PublisherUSSurfaceGroup {
        let settings = app.buttons["Settings"].firstMatch
        try require(settings.waitForExistence(timeout: 15) && settings.isHittable,
                    "Settings control is not reachable.")
        settings.tap()
        let advertising = app.buttons["Advertising choices"].firstMatch
        for _ in 0..<8 {
            if advertising.exists && advertising.isHittable { break }
            app.swipeUp()
        }
        try require(advertising.exists && advertising.isHittable, "US privacy entry point is not reachable in Settings.")
        advertising.tap()
        let editing = try waitForSnapshot("real US privacy form suspends requests") {
            $0.busy && !$0.canRequestAds && $0.formPresentations > previous.formPresentations
        }
        let surface = try publisherWaitForUSSurface()
        try assertNoRequestIncrease(from: editing.requestCount, for: 3)
        publisherRecordUSSurfaceEvidence(surface.canonical, name: "publisher-us-options-open")
        return surface
    }

    private struct PublisherUSSurface {
        let webView: XCUIElement
        let controls: [XCUIElement]
        let path: String
        let windowIndex: Int
    }

    private struct PublisherUSSurfaceGroup {
        let canonical: PublisherUSSurface
        let aliases: [PublisherUSSurface]
    }

    // Runs 40954332187/40957397385 expose a preloaded tree below a 1x1
    // ancestor, and broad descendant queries return matching controls from
    // three wrappers. Walk public children at EVERY level instead. Preserve
    // the ancestor clip and only collect terminal full-screen WebViews;
    // three nested WebView wrappers are one form, not three candidates.
    private func publisherUSSurfaces() -> (surfaces: [PublisherUSSurface], diagnostics: [String]) {
        var surfaces: [PublisherUSSurface] = []
        var diagnostics: [String] = []
        var visited = 0
        var traversalComplete = true

        func coversScreen(_ frame: CGRect, _ screen: CGRect) -> Bool {
            frame.width > 1 && frame.height > 1
                && frame.minX <= screen.minX + screen.width * 0.01
                && frame.minY <= screen.minY + screen.height * 0.01
                && frame.maxX >= screen.maxX - screen.width * 0.01
                && frame.maxY >= screen.maxY - screen.height * 0.01
        }

        func permittedVisit(_ path: String, _ depth: Int) -> Bool {
            visited += 1
            guard visited <= 300 && depth <= 48 else {
                traversalComplete = false
                diagnostics.append("\(path): traversal bound exceeded; no candidate may pass")
                return false
            }
            return true
        }

        func terminalWebViews(_ node: XCUIElement, screen: CGRect, clip: CGRect,
                              path: String, depth: Int) -> [(XCUIElement, String)] {
            guard permittedVisit(path, depth) else { return [] }
            let frame = node.frame
            let visible = clip.intersection(frame)
            guard coversScreen(frame, screen), coversScreen(visible, screen) else {
                diagnostics.append("\(path) frame=\(frame) clip=\(visible): pruned before children")
                return []
            }
            let type = node.elementType
            diagnostics.append("\(path) type=\(type.rawValue) frame=\(frame): full ancestor")
            var deeper: [(XCUIElement, String)] = []
            for (index, child) in node.children(matching: .any).allElementsBoundByIndex.enumerated() {
                deeper += terminalWebViews(child, screen: screen, clip: visible,
                                           path: "\(path)/child[\(index)]", depth: depth + 1)
            }
            if type == .webView && deeper.isEmpty { return [(node, path)] }
            return deeper
        }

        func collectControls(_ node: XCUIElement, clip: CGRect, path: String,
                             depth: Int, controls: inout [XCUIElement]) {
            guard permittedVisit(path, depth) else { return }
            let frame = node.frame
            let visible = clip.intersection(frame)
            guard frame.width > 1 && frame.height > 1, visible.width > 1, visible.height > 1 else {
                diagnostics.append("\(path) frame=\(frame): clipped control branch pruned before children")
                return
            }
            let type = node.elementType
            // A nested WebView here did not satisfy full-surface traversal.
            // Do not merge its controls or silently accept another document.
            guard type != .webView else {
                traversalComplete = false
                diagnostics.append("\(path): unexpected nested document in terminal WebView")
                return
            }
            // Keep the complete visible node set, including decorative nodes,
            // for exact equivalence; actionable filters are applied later.
            controls.append(node)
            for (index, child) in node.children(matching: .any).allElementsBoundByIndex.enumerated() {
                collectControls(child, clip: visible, path: "\(path)/child[\(index)]",
                                depth: depth + 1, controls: &controls)
            }
        }

        for (windowIndex, window) in app.windows.allElementsBoundByIndex.enumerated() {
            let screen = window.frame
            guard screen.width > 1 && screen.height > 1 else { continue }
            for (childIndex, child) in window.children(matching: .any).allElementsBoundByIndex.enumerated() {
                let terminals = terminalWebViews(child, screen: screen, clip: screen,
                    path: "window[\(windowIndex)]/child[\(childIndex)]", depth: 0)
                for (webView, path) in terminals {
                    var controls: [XCUIElement] = []
                    for (index, content) in webView.children(matching: .any).allElementsBoundByIndex.enumerated() {
                        collectControls(content, clip: screen.intersection(webView.frame),
                                        path: "\(path)/content[\(index)]", depth: 0, controls: &controls)
                    }
                    let headings = controls.filter { $0.elementType == .staticText && $0.label == "My data preferences" }
                    let saves = controls.filter { $0.elementType == .button && $0.label == "Save and close" }
                    diagnostics.append("\(path): terminal WebView frame=\(webView.frame), controls=\(controls.count), headings=\(headings.count), saves=\(saves.count)")
                    if !headings.isEmpty || !saves.isEmpty {
                        surfaces.append(PublisherUSSurface(webView: webView, controls: controls, path: path,
                                                           windowIndex: windowIndex))
                    }
                }
            }
        }
        // A partial walk cannot establish uniqueness.
        if !traversalComplete { surfaces.removeAll() }
        return (surfaces, diagnostics)
    }

    private func publisherWaitForUSSurface() throws -> PublisherUSSurfaceGroup {
        var found: (surfaces: [PublisherUSSurface], diagnostics: [String]) = ([], [])
        let visible = NSPredicate { [weak self] _, _ in
            guard let self, !self.springboard.alerts.firstMatch.exists,
                  let state = self.snapshot(), state.busy, !state.canRequestAds,
                  state.formPresentations > 0 else { return false }
            found = self.publisherUSSurfaces()
            return !found.surfaces.isEmpty
        }
        let result = XCTWaiter.wait(for: [XCTNSPredicateExpectation(predicate: visible, object: nil)], timeout: networkTimeout)
        for line in found.diagnostics { print("TAROT_QA_US_SURFACE \(line)") }
        let evidence = XCTAttachment(string: found.diagnostics.joined(separator: "\n"))
        evidence.name = "publisher-us-window-surface-diagnostics"
        evidence.lifetime = .keepAlways
        add(evidence)
        try requireUMPTapReady()
        try require(result == .completed && !found.surfaces.isEmpty,
                    "No terminal US WebView with an unclipped full-surface ancestor chain was found.")
        return try publisherGroupEquivalentSurfaces(found.surfaces, phase: "before-selection")
    }

    private func publisherExactFrame(_ frame: CGRect) throws -> [String] {
        let coordinates = [Double(frame.minX), Double(frame.minY), Double(frame.width), Double(frame.height)]
        try require(coordinates.allSatisfy { $0.isFinite }, "Non-finite US control frame cannot establish equivalence.")
        // Exact IEEE bits, without rounding coordinates or merging near copies.
        return coordinates.map { String($0.bitPattern, radix: 16) }
    }

    private func publisherStableJSON(_ value: Any) throws -> String {
        let data = try JSONSerialization.data(withJSONObject: value, options: [.sortedKeys])
        return String(decoding: data, as: UTF8.self)
    }

    private func publisherSurfaceSignature(_ surface: PublisherUSSurface) throws -> String {
        try requireUMPTapReady()
        let window = app.windows.element(boundBy: surface.windowIndex)
        try require(window.exists && surface.webView.exists, "A US representation lost its Window or WebView.")
        var controls: [String] = []
        for control in surface.controls {
            try require(control.exists, "A US control disappeared while checking exact representation equivalence.")
            let state: [String: Any] = [
                "type": control.elementType.rawValue, "label": control.label,
                "frameBits": try publisherExactFrame(control.frame),
                "binaryValue": publisherUSRadioValue(control).map { String($0) } ?? "not-binary",
                "selected": control.isSelected, "enabled": control.isEnabled, "hittable": control.isHittable
            ]
            controls.append(try publisherStableJSON(state))
        }
        // Sorted MULTISET: duplicate nodes remain duplicates. Do not deduplicate
        // by count, coordinates alone, or the diagnostic fingerprint below.
        return try publisherStableJSON([
            "windowIndex": surface.windowIndex, "windowFrameBits": try publisherExactFrame(window.frame),
            "webViewFrameBits": try publisherExactFrame(surface.webView.frame),
            "webViewLabel": surface.webView.label, "controls": controls.sorted()
        ])
    }

    private func publisherSignatureFingerprint(_ signature: String) -> String {
        // Log label only. Grouping always compares the complete exact strings,
        // so a fingerprint collision cannot merge two different control sets.
        var value: UInt64 = 14695981039346656037
        for byte in signature.utf8 { value = (value ^ UInt64(byte)) &* 1099511628211 }
        return String(value, radix: 16)
    }

    private func publisherGroupEquivalentSurfaces(_ surfaces: [PublisherUSSurface], phase: String) throws -> PublisherUSSurfaceGroup {
        var groups: [String: [PublisherUSSurface]] = [:]
        var diagnostics: [String] = []
        for surface in surfaces {
            // Every representation must itself contain the exact unique
            // heading, Save button, titles and binary-valued radio pair.
            _ = try publisherUSControl(in: surface, label: "My data preferences", button: false)
            _ = try publisherUSControl(in: surface, label: "Save and close", button: true)
            for allow in [false, true] {
                _ = try publisherUSControl(in: surface, label: publisherUSOptionCopy(allow: allow).title, button: false)
                _ = try publisherUSRadio(in: surface, allow: allow)
            }
            let signature = try publisherSurfaceSignature(surface)
            groups[signature, default: []].append(surface)
            let line = "phase=\(phase) path=\(surface.path) fingerprint=\(publisherSignatureFingerprint(signature)) exactControlSet=\(signature)"
            diagnostics.append(line)
            print("TAROT_QA_US_EQUIVALENCE \(line)")
        }
        print("TAROT_QA_US_GROUPS phase=\(phase) representations=\(surfaces.count) exactGroups=\(groups.count)")
        let evidence = XCTAttachment(string: diagnostics.joined(separator: "\n"))
        evidence.name = "publisher-us-equivalence-\(phase)"
        evidence.lifetime = .keepAlways
        add(evidence)
        try require(groups.count == 1, "US surface representations differ in Window, geometry, complete controls or state; refusing ambiguous interaction.")
        // All members are now proven physically/state equivalent. The path
        // only chooses a deterministic API representation of that one target.
        let aliases = surfaces.sorted { $0.path < $1.path }
        return PublisherUSSurfaceGroup(canonical: aliases[0], aliases: aliases)
    }

    private func publisherRereadSurface(_ surface: PublisherUSSurface) throws -> PublisherUSSurface {
        try requireUMPTapReady()
        var controls: [XCUIElement] = []
        var visited = 0
        func collect(_ node: XCUIElement, clip: CGRect, depth: Int) throws {
            visited += 1
            try require(visited <= 150 && depth <= 48, "Cannot prove US representation consistency from a partial traversal.")
            let frame = node.frame
            let visible = clip.intersection(frame)
            guard frame.width > 1 && frame.height > 1, visible.width > 1, visible.height > 1 else { return }
            try require(node.elementType != .webView, "A second document appeared inside the terminal US WebView.")
            controls.append(node)
            for child in node.children(matching: .any).allElementsBoundByIndex {
                try collect(child, clip: visible, depth: depth + 1)
            }
        }
        let window = app.windows.element(boundBy: surface.windowIndex)
        try require(window.exists && surface.webView.exists, "US representation disappeared before Save.")
        let screen = window.frame
        let clip = screen.intersection(surface.webView.frame)
        try require(screen.width > 1 && screen.height > 1
                    && clip.width >= screen.width * 0.99 && clip.height >= screen.height * 0.99,
                    "US representation is no longer a full-surface WebView before Save.")
        for child in surface.webView.children(matching: .any).allElementsBoundByIndex {
            try collect(child, clip: clip, depth: 0)
        }
        return PublisherUSSurface(webView: surface.webView, controls: controls,
                                  path: surface.path, windowIndex: surface.windowIndex)
    }

    private func publisherUSControl(in surface: PublisherUSSurface, label: String, button: Bool) throws -> XCUIElement {
        try requireUMPTapReady()
        let controls = surface.controls.filter { $0.elementType == (button ? .button : .staticText) && $0.label == label }
        try require(controls.count == 1, "Expected one scoped US control '\(label)'; found \(controls.count).")
        try require(controls[0].isHittable, "Scoped US control is not hittable: \(label).")
        return controls[0]
    }

    private func publisherRecordUSSurfaceEvidence(_ surface: PublisherUSSurface, name: String) {
        let screenshot = XCTAttachment(screenshot: surface.webView.screenshot())
        screenshot.name = name
        screenshot.lifetime = .keepAlways
        add(screenshot)
        if let json = snapshotJSON() {
            let state = XCTAttachment(string: json)
            state.name = "\(name)-consent-state"
            state.lifetime = .keepAlways
            add(state)
        }
    }

    private func publisherUSOptionCopy(allow: Bool) -> (title: String, body: String) {
        let title = allow ? "Allow the sale or sharing of my data" : "Don't sell or share my data"
        let body = allow
            ? "By allowing the sale or sharing of your data, you will see interest-based ads on our sites"
            : "We won't sell or share your personal information to inform the ads you see. You may still see interest-based ads if your information is sold or shared by other companies or was sold or shared previously."
        return (title, body)
    }

    private func publisherUSRadioValue(_ element: XCUIElement) -> Int? {
        if let value = element.value as? String, ["0", "1"].contains(value) { return Int(value) }
        if let value = element.value as? NSNumber, [0, 1].contains(value.intValue),
           value.doubleValue == Double(value.intValue) { return value.intValue }
        return nil
    }

    private func publisherUSRadio(in surface: PublisherUSSurface, allow: Bool) throws -> XCUIElement {
        try requireUMPTapReady()
        let (title, body) = publisherUSOptionCopy(allow: allow)
        // WebKit can combine a radio title and its description into one AX label.
        // Only the exact observed title, optionally followed by its exact body.
        let expression = "^" + NSRegularExpression.escapedPattern(for: title)
            + "(?:\\s+" + NSRegularExpression.escapedPattern(for: body) + ")?$"
        let predicate = NSPredicate(format: "SELF MATCHES %@", expression)
        let options = surface.controls.filter {
            predicate.evaluate(with: $0.label) && $0.isHittable && publisherUSRadioValue($0) != nil
        }
        let semantic = options.filter { $0.elementType == .radioButton }
        let controls = semantic.isEmpty ? options.filter { $0.elementType == .other } : semantic
        print("TAROT_QA_US_RADIO surface=\(surface.path) choice=\(allow ? "allow" : "opt-out") count=\(controls.count)")
        for control in controls {
            print("TAROT_QA_US_RADIO_CONTROL frame=\(control.frame) value=\(String(describing: publisherUSRadioValue(control)))")
        }
        try require(controls.count == 1,
                    "Expected one explicit US radio with binary value: \(title); found \(controls.count).")
        return controls[0]
    }

    private func publisherSelectUSOption(in group: PublisherUSSurfaceGroup, allow: Bool) throws {
        let surface = group.canonical
        let option = try publisherUSRadio(in: surface, allow: allow)
        try require(publisherUSRadioValue(option) == 0, "The requested US option must start unselected to prove an explicit change.")
        publisherRecordUSSurfaceEvidence(surface, name: allow ? "publisher-us-before-allow" : "publisher-us-before-opt-out")
        if option.elementType == .radioButton {
            try tapActiveUMPElement(option)
        } else {
            // Run 40950542146: WebKit exposes the radio as Other(value 0/1),
            // plus a sibling text-only Other. The row's centre is body text;
            // screenshot AE13F0B8 shows the circle at the first title line's
            // left. Derive its centre from live row/title geometry, not screen
            // coordinates. The shorter of the two titles is one line in this
            // observed English form (the Allow title wraps onto two lines).
            try requireUMPTapReady()
            let title = try publisherUSControl(in: surface, label: publisherUSOptionCopy(allow: allow).title, button: false)
            let otherTitle = try publisherUSControl(in: surface, label: publisherUSOptionCopy(allow: !allow).title, button: false)
            let row = option.frame
            let text = title.frame
            let lineHeight = min(text.height, otherTitle.frame.height)
            let offset = CGVector(dx: lineHeight / 2, dy: text.minY - row.minY + lineHeight / 2)
            try require(row.contains(text) && lineHeight >= 12 && lineHeight <= 36
                        && text.minX > row.minX && offset.dx < text.minX - row.minX
                        && offset.dy > 0 && offset.dy < row.height,
                        "US radio layout no longer matches the observed first-line circle geometry.")
            let geometry = XCTAttachment(string: "Target=\(allow ? "allow" : "opt-out"); row=\(row); title=\(text); firstLineHeight=\(lineHeight); relativeCircleOffset=\(offset)")
            geometry.name = "publisher-us-radio-relative-target"
            geometry.lifetime = .keepAlways
            add(geometry)
            try requireUMPTapReady()
            let interruptionsBefore = interruptedAppTapCount
            try require(!springboard.alerts.firstMatch.exists, "System alert prevents the US radio tap.")
            option.coordinate(withNormalizedOffset: .zero).withOffset(offset).tap()
            try require(interruptedAppTapCount == interruptionsBefore,
                        "ATT interrupted the US radio tap; do not certify a resumed app event.")
        }

        let changed = NSPredicate { [weak self] _, _ in
            guard let self, !self.springboard.alerts.firstMatch.exists,
                  let selected = try? self.publisherUSRadio(in: surface, allow: allow),
                  let other = try? self.publisherUSRadio(in: surface, allow: !allow) else { return false }
            return self.publisherUSRadioValue(selected) == 1 && self.publisherUSRadioValue(other) == 0
        }
        let result = XCTWaiter.wait(for: [XCTNSPredicateExpectation(predicate: changed, object: nil)], timeout: 15)
        // Capture the real control state even if the click had no effect.
        try requireUMPTapReady()
        let selectedValue = publisherUSRadioValue(try publisherUSRadio(in: surface, allow: allow))
        let otherValue = publisherUSRadioValue(try publisherUSRadio(in: surface, allow: !allow))
        publisherRecordUSSurfaceEvidence(surface, name: allow ? "publisher-us-allow-before-save" : "publisher-us-opt-out-before-save")
        let selection = XCTAttachment(string: "Explicit selection=\(allow ? "allow" : "opt-out"); selectedRadioValue=\(String(describing: selectedValue)); otherRadioValue=\(String(describing: otherValue)); saved=false")
        selection.name = "publisher-us-real-radio-selection"
        selection.lifetime = .keepAlways
        add(selection)
        try require(result == .completed && selectedValue == 1 && otherValue == 0,
                    "US radio selection was not confirmed (selected=1, other=0); refuse Save.")
        let refreshed = try group.aliases.map { try publisherRereadSurface($0) }
        let consistent = try publisherGroupEquivalentSurfaces(refreshed, phase: "before-save")
        for alias in consistent.aliases {
            let selected = publisherUSRadioValue(try publisherUSRadio(in: alias, allow: allow))
            let other = publisherUSRadioValue(try publisherUSRadio(in: alias, allow: !allow))
            print("TAROT_QA_US_PRESAVE path=\(alias.path) selected=\(String(describing: selected)) other=\(String(describing: other))")
            try require(selected == 1 && other == 0, "A US alias is stale or inconsistent before Save; no choice will be saved.")
        }
        let save = try publisherUSControl(in: consistent.canonical, label: "Save and close", button: true)
        try tapActiveUMPElement(save)
    }
