    // Inject only into the existing simulator XCTest class before build-for-testing.
    // Uses Tarot's published CMP with Google's sample BANNER, never live inventory.
    // Exact English labels/body were observed in the publisher editor on 2026-10-29.
    // An older Opt out/Dismiss-only form must fail the explicit-undo check: Dismiss
    // is not opt-in. Propagation/network failures are failures, never fake choices.
    func testPublisherUSOptOutPersistsAndCanBeExplicitlyReversed() throws {
        expectedATTAction = "Ask App Not to Track"
        publisherLaunchUS(reset: true)
        let initial = try waitForSnapshot("strict publisher-message simulator guard") { _ in true }
        try require(initial.publisherMessageQA == true, "Publisher CMP audit guard is not active.")
        XCTAssertEqual(initial.initialTrackingAuthorizationRaw, 0)
        try publisherFinishOptionalATT()
        let baseline = try publisherWaitForUSState("published US message and sample banner", banner: true)
        try require(baseline.requiresPrivacyOptions == true, "UMP did not require the US privacy-options entry point.")
        recordEvidence("publisher-us-initial")

        try publisherOpenUSOptions(after: baseline)
        try publisherSelectUSOption(allow: false)
        let optedOut = try publisherWaitForUSState("real US opt-out saved", expectedOptOut: 1)
        recordEvidence("publisher-us-opted-out")

        app.terminate()
        publisherLaunchUS(reset: false)
        try publisherFinishOptionalATT()
        let persisted = try publisherWaitForUSState("US opt-out persists across launch with sample banner",
                                                   expectedOptOut: 1, banner: true)
        XCTAssertEqual(persisted.gppSectionIDs, optedOut.gppSectionIDs)
        recordEvidence("publisher-us-opt-out-persisted")

        try publisherOpenUSOptions(after: persisted)
        try publisherSelectUSOption(allow: true)
        _ = try publisherWaitForUSState("explicit Allow action undoes the US opt-out", expectedOptOut: 2)
        recordEvidence("publisher-us-explicit-allow")

        app.terminate()
        publisherLaunchUS(reset: false)
        try publisherFinishOptionalATT()
        _ = try publisherWaitForUSState("explicit US choice persists with sample banner",
                                       expectedOptOut: 2, banner: true)
        // GPP 2 means did-not-opt-out for these three fields, not ATT permission,
        // proof of personalized delivery, or a forecast of monetization.
        recordEvidence("publisher-us-explicit-allow-persisted")
    }

    private func publisherLaunchUS(reset: Bool) {
        app.launchArguments = ["--qa-english", "--qa-consent-us", "--qa-consent-observe",
                               "-AppleLanguages", "(en)", "-AppleLocale", "en_US"]
        if reset { app.launchArguments += ["--qa-consent-reset", "--qa-consent-fresh-case"] }
        app.launch()
    }

    private func publisherFinishOptionalATT() throws {
        try finishOptionalATTWithDenial()
    }

    private func publisherWaitForUSState(_ description: String, expectedOptOut: Int? = nil,
                                         banner: Bool = false) throws -> Snapshot {
        try waitForSnapshot(description) { state in
            guard state.publisherMessageQA == true, state.updateCompleted, !state.busy
            else { return false }
            if let expectedOptOut {
                // Google documents stored GPP after a decision. Its absence
                // before opening privacy options is not a baseline failure.
                guard state.gppPresent == true, state.gppSectionIDs == [7],
                      ["usNationalV1", "usNationalV2"].contains(state.gppObservation ?? ""),
                      state.gppSaleOptOut == expectedOptOut,
                      state.gppSharingOptOut == expectedOptOut,
                      state.gppTargetedAdvertisingOptOut == expectedOptOut else { return false }
            }
            return !banner || (state.automaticPresentationAllowed && state.canRequestAds && state.sdkStarted
                               && state.requestCount > 0 && state.loadedBannerCount > 0)
        }
    }

    private func publisherOpenUSOptions(after previous: Snapshot) throws {
        let settings = app.buttons["Settings"].firstMatch
        try require(settings.waitForExistence(timeout: 15) && settings.isHittable,
                    "Settings control is not reachable.")
        settings.tap()
        let advertising = app.buttons["Advertising choices"].firstMatch
        for _ in 0..<8 {
            if advertising.exists && advertising.isHittable { break }
            app.swipeUp()
        }
        try require(advertising.exists && advertising.isHittable, "US privacy entry point is not reachable in Settings.")
        advertising.tap()
        let editing = try waitForSnapshot("real US privacy form suspends requests") {
            $0.busy && !$0.canRequestAds && $0.formPresentations > previous.formPresentations
        }
        let surface = try publisherWaitForUSSurface()
        try assertNoRequestIncrease(from: editing.requestCount, for: 3)
        publisherRecordUSSurfaceEvidence(surface, name: "publisher-us-options-open")
    }

    // Run 40954332187 exposed duplicate UMP AX trees: the preloaded tree is
    // beneath a direct Window child sized 1x1, even though its descendants
    // claim full-sized frames and isHittable. Reject that ancestor BEFORE any
    // descendant query. Never choose a copy by its x position or first match.
    private func publisherUSSurfaces() -> (surfaces: [XCUIElement], diagnostics: [String]) {
        var surfaces: [XCUIElement] = []
        var diagnostics: [String] = []
        for (windowIndex, window) in app.windows.allElementsBoundByIndex.enumerated() {
            let screen = window.frame
            guard screen.width > 1 && screen.height > 1 else { continue }
            for (childIndex, child) in window.children(matching: .any).allElementsBoundByIndex.enumerated() {
                let frame = child.frame
                let full = frame.width > 1 && frame.height > 1
                    && abs(frame.minX - screen.minX) <= screen.width * 0.01
                    && abs(frame.minY - screen.minY) <= screen.height * 0.01
                    && abs(frame.width - screen.width) <= screen.width * 0.01
                    && abs(frame.height - screen.height) <= screen.height * 0.01
                guard full else {
                    diagnostics.append("window[\(windowIndex)] child[\(childIndex)] frame=\(frame): excluded non-full/clip ancestor; descendants not queried")
                    continue
                }
                let headings = child.staticTexts.matching(NSPredicate(format: "label == %@", "My data preferences"))
                    .allElementsBoundByIndex
                let saves = child.buttons.matching(NSPredicate(format: "label == %@", "Save and close"))
                    .allElementsBoundByIndex
                diagnostics.append("window[\(windowIndex)] child[\(childIndex)] frame=\(frame): headings=\(headings.count), saves=\(saves.count)")
                // Keep any matching branch so the caller rejects ambiguity,
                // including duplicate forms inside one full-sized ancestor.
                if !headings.isEmpty || !saves.isEmpty { surfaces.append(child) }
            }
        }
        return (surfaces, diagnostics)
    }

    private func publisherWaitForUSSurface() throws -> XCUIElement {
        let visible = NSPredicate { [weak self] _, _ in
            guard let self, !self.springboard.alerts.firstMatch.exists,
                  let state = self.snapshot(), state.busy, !state.canRequestAds,
                  state.formPresentations > 0 else { return false }
            return !self.publisherUSSurfaces().surfaces.isEmpty
        }
        let result = XCTWaiter.wait(for: [XCTNSPredicateExpectation(predicate: visible, object: nil)], timeout: networkTimeout)
        try requireUMPTapReady()
        let found = publisherUSSurfaces()
        let evidence = XCTAttachment(string: found.diagnostics.joined(separator: "\n"))
        evidence.name = "publisher-us-window-surface-diagnostics"
        evidence.lifetime = .keepAlways
        add(evidence)
        try require(result == .completed && found.surfaces.count == 1,
                    "Expected one US form under a full-sized direct Window child; found \(found.surfaces.count).")
        let surface = found.surfaces[0]
        _ = try publisherUSControl(in: surface, label: "My data preferences", button: false)
        _ = try publisherUSControl(in: surface, label: "Save and close", button: true)
        return surface
    }

    private func publisherUSControl(in surface: XCUIElement, label: String, button: Bool) throws -> XCUIElement {
        try requireUMPTapReady()
        let query = button ? surface.buttons : surface.staticTexts
        let controls = query.matching(NSPredicate(format: "label == %@", label)).allElementsBoundByIndex
        try require(controls.count == 1, "Expected one scoped US control '\(label)'; found \(controls.count).")
        try require(controls[0].isHittable, "Scoped US control is not hittable: \(label).")
        return controls[0]
    }

    private func publisherRecordUSSurfaceEvidence(_ surface: XCUIElement, name: String) {
        let screenshot = XCTAttachment(screenshot: surface.screenshot())
        screenshot.name = name
        screenshot.lifetime = .keepAlways
        add(screenshot)
        if let json = snapshotJSON() {
            let state = XCTAttachment(string: json)
            state.name = "\(name)-consent-state"
            state.lifetime = .keepAlways
            add(state)
        }
    }

    private func publisherUSOptionCopy(allow: Bool) -> (title: String, body: String) {
        let title = allow ? "Allow the sale or sharing of my data" : "Don't sell or share my data"
        let body = allow
            ? "By allowing the sale or sharing of your data, you will see interest-based ads on our sites"
            : "We won't sell or share your personal information to inform the ads you see. You may still see interest-based ads if your information is sold or shared by other companies or was sold or shared previously."
        return (title, body)
    }

    private func publisherUSRadioValue(_ element: XCUIElement) -> Int? {
        if let value = element.value as? String, ["0", "1"].contains(value) { return Int(value) }
        if let value = element.value as? NSNumber, [0, 1].contains(value.intValue),
           value.doubleValue == Double(value.intValue) { return value.intValue }
        return nil
    }

    private func publisherUSRadio(in surface: XCUIElement, allow: Bool) throws -> XCUIElement {
        try requireUMPTapReady()
        let (title, body) = publisherUSOptionCopy(allow: allow)
        // WebKit can combine a radio title and its description into one AX label.
        // Only the exact observed title, optionally followed by its exact body.
        let expression = "^" + NSRegularExpression.escapedPattern(for: title)
            + "(?:\\s+" + NSRegularExpression.escapedPattern(for: body) + ")?$"
        let predicate = NSPredicate(format: "label MATCHES %@", expression)
        let options = surface.descendants(matching: .any).matching(predicate).allElementsBoundByIndex
            .filter { $0.isHittable && publisherUSRadioValue($0) != nil }
        let semantic = options.filter { $0.elementType == .radioButton }
        let controls = semantic.isEmpty ? options.filter { $0.elementType == .other } : semantic
        try require(controls.count == 1,
                    "Expected one explicit US radio with binary value: \(title); found \(controls.count).")
        return controls[0]
    }

    private func publisherSelectUSOption(allow: Bool) throws {
        let surface = try publisherWaitForUSSurface()
        let option = try publisherUSRadio(in: surface, allow: allow)
        try require(publisherUSRadioValue(option) == 0, "The requested US option must start unselected to prove an explicit change.")
        publisherRecordUSSurfaceEvidence(surface, name: allow ? "publisher-us-before-allow" : "publisher-us-before-opt-out")
        if option.elementType == .radioButton {
            try tapActiveUMPElement(option)
        } else {
            // Run 40950542146: WebKit exposes the radio as Other(value 0/1),
            // plus a sibling text-only Other. The row's centre is body text;
            // screenshot AE13F0B8 shows the circle at the first title line's
            // left. Derive its centre from live row/title geometry, not screen
            // coordinates. The shorter of the two titles is one line in this
            // observed English form (the Allow title wraps onto two lines).
            try requireUMPTapReady()
            let title = try publisherUSControl(in: surface, label: publisherUSOptionCopy(allow: allow).title, button: false)
            let otherTitle = try publisherUSControl(in: surface, label: publisherUSOptionCopy(allow: !allow).title, button: false)
            let row = option.frame
            let text = title.frame
            let lineHeight = min(text.height, otherTitle.frame.height)
            let offset = CGVector(dx: lineHeight / 2, dy: text.minY - row.minY + lineHeight / 2)
            try require(row.contains(text) && lineHeight >= 12 && lineHeight <= 36
                        && text.minX > row.minX && offset.dx < text.minX - row.minX
                        && offset.dy > 0 && offset.dy < row.height,
                        "US radio layout no longer matches the observed first-line circle geometry.")
            let geometry = XCTAttachment(string: "Target=\(allow ? "allow" : "opt-out"); row=\(row); title=\(text); firstLineHeight=\(lineHeight); relativeCircleOffset=\(offset)")
            geometry.name = "publisher-us-radio-relative-target"
            geometry.lifetime = .keepAlways
            add(geometry)
            try requireUMPTapReady()
            let interruptionsBefore = interruptedAppTapCount
            try require(!springboard.alerts.firstMatch.exists, "System alert prevents the US radio tap.")
            option.coordinate(withNormalizedOffset: .zero).withOffset(offset).tap()
            try require(interruptedAppTapCount == interruptionsBefore,
                        "ATT interrupted the US radio tap; do not certify a resumed app event.")
        }

        let changed = NSPredicate { [weak self] _, _ in
            guard let self, !self.springboard.alerts.firstMatch.exists,
                  let selected = try? self.publisherUSRadio(in: surface, allow: allow),
                  let other = try? self.publisherUSRadio(in: surface, allow: !allow) else { return false }
            return self.publisherUSRadioValue(selected) == 1 && self.publisherUSRadioValue(other) == 0
        }
        let result = XCTWaiter.wait(for: [XCTNSPredicateExpectation(predicate: changed, object: nil)], timeout: 15)
        // Capture the real control state even if the click had no effect.
        try requireUMPTapReady()
        let selectedValue = publisherUSRadioValue(try publisherUSRadio(in: surface, allow: allow))
        let otherValue = publisherUSRadioValue(try publisherUSRadio(in: surface, allow: !allow))
        publisherRecordUSSurfaceEvidence(surface, name: allow ? "publisher-us-allow-before-save" : "publisher-us-opt-out-before-save")
        let selection = XCTAttachment(string: "Explicit selection=\(allow ? "allow" : "opt-out"); selectedRadioValue=\(String(describing: selectedValue)); otherRadioValue=\(String(describing: otherValue)); saved=false")
        selection.name = "publisher-us-real-radio-selection"
        selection.lifetime = .keepAlways
        add(selection)
        try require(result == .completed && selectedValue == 1 && otherValue == 0,
                    "US radio selection was not confirmed (selected=1, other=0); refuse Save.")
        let save = try publisherUSControl(in: surface, label: "Save and close", button: true)
        try tapActiveUMPElement(save)
    }
