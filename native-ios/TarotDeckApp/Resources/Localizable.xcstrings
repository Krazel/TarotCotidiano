    "Every card meaning requires an artwork description." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "El significado de cada carta necesita una descripción de la ilustración." } } } },
    "Example card %d of 3, face down" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Carta de ejemplo %d de 3, boca abajo" } } } },
    "Expected 6 guide articles, found %d." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Se esperaban 6 artículos de guía; se encontraron %d." } } } },
    "Expected 78 card meanings, found %d." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Se esperaban 78 significados; se encontraron %d." } } } },
    "Expected 78 cards, found %d." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Se esperaban 78 cartas; se encontraron %d." } } } },
    "Missing bundled content resource: %@." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Falta un recurso de contenido incluido: %@." } } } },
    "The deck and meaning card identifiers do not match." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Los identificadores del mazo y de los significados no coinciden." } } } },
    "The saved reading details were damaged and have been safely cleared." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Los detalles de la lectura guardada estaban dañados y se han borrado de forma segura." } } } },
    "The reading ended, but its recovery marker still needs to be cleared." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "La lectura terminó, pero todavía hay que borrar su marcador de recuperación." } } } },
    "The previous reading was cleared, but the new layout couldn't be saved." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "La lectura anterior se borró, pero no se pudo guardar el nuevo tipo de lectura." } } } },
    "We couldn't clear the unshuffled layout. Nothing was changed." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo borrar la disposición sin barajar. No se cambió nada." } } } },
    "Your shuffled reading was recovered safely." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "La lectura barajada se ha recuperado de forma segura." } } } },
    "We found the saved reading but couldn't finish restoring it." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Se encontró la lectura guardada, pero no se pudo terminar de restaurar." } } } },
    "The saved reading was invalid and has been safely cleared." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "La lectura guardada no era válida y se ha borrado de forma segura." } } } },
    "The invalid session was removed, but its recovery marker still needs to be cleared." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "La sesión no válida se eliminó, pero todavía hay que borrar su marcador de recuperación." } } } },
    "The previous reading was incomplete and has been safely cleared." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "La lectura anterior estaba incompleta y se ha borrado de forma segura." } } } },
    "The stale recovery marker couldn't be cleared yet." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Todavía no se pudo borrar el marcador de recuperación antiguo." } } } },
    "The saved reading couldn't be represented safely and has been cleared." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "La lectura guardada no se podía representar de forma segura y se ha borrado." } } } },
    "We couldn't finish clearing the unreadable reading. Try again." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo terminar de borrar la lectura ilegible. Inténtalo de nuevo." } } } },
    "We found an invalid reading but couldn't clear it yet." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Se encontró una lectura no válida, pero todavía no se pudo borrar." } } } },
    "The invalid reading was safely cleared." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "La lectura no válida se ha borrado de forma segura." } } } },
