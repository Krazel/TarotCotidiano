    "Tap an empty position to place the next card, or tap the deck to shuffle again." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Toca una posición vacía para colocar la siguiente carta o toca el mazo para volver a barajar." } } } },
    "Tap any empty position to place the next card." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Toca cualquier posición vacía para colocar la siguiente carta." } } } },
