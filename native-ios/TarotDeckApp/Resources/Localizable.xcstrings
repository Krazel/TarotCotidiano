    "Starts the Apple purchase confirmation" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Inicia la confirmación de compra de Apple" } } } },
    "Each option is a monthly auto-renewable subscription. Payment is charged to your Apple Account and renews automatically until cancelled." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Cada opción es una suscripción mensual con renovación automática. El pago se carga a tu cuenta de Apple y se renueva automáticamente hasta que la canceles." } } } },
    "Manage or cancel in your Apple Account. The full app stays free with or without support." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Gestiona o cancela desde tu cuenta de Apple. La aplicación completa sigue siendo gratuita con o sin apoyo." } } } },
