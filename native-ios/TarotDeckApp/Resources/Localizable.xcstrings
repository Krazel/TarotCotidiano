    "Shuffle recovery paused" : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "Recuperación del barajado en pausa" } } } },
    "The deck was shuffled, but its recovery marker still needs to be updated." : { "localizations" : { "es" : { "stringUnit" : { "state" : "translated", "value" : "El mazo se ha barajado, pero aún falta actualizar su marcador de recuperación." } } } },
